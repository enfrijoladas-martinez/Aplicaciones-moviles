<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sensores y NavDrawer"
                android:textColor="@color/negro"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seis sensores, cada uno en su propia Activity, integrados con un menu lateral. Desliza desde el borde izquierdo o toca el icono de arriba para abrirlo."
                android:textColor="@color/gris"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="6dp"
            android:text="Que trae este equipo"
            android:textColor="@color/negro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/listaSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La lista se arma en tiempo real preguntandole al SensorManager, no esta escrita a mano."
            android:textColor="@color/gris"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
