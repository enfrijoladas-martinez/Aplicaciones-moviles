<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="Recuperar contrasena"
            android:textColor="@color/negro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Te mandamos un codigo a tu correo"
            android:textColor="@color/gris"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/paso1"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/campo"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/blanco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/gris_claro" />

            <TextView
                android:id="@+id/paso2"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/campo"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/gris"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:background="@color/gris_claro" />

            <TextView
                android:id="@+id/paso3"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/campo"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/gris"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:id="@+id/bloqueCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Correo de tu cuenta"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/campo"
                    android:hint="correo@gmail.com"
                    android:inputType="textEmailAddress"
                    android:padding="13dp"
                    android:textColor="@color/negro"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueCodigo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Codigo de 6 digitos"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/campo"
                    android:gravity="center"
                    android:hint="000000"
                    android:inputType="number"
                    android:letterSpacing="0.4"
                    android:maxLength="6"
                    android:padding="15dp"
                    android:textColor="@color/negro"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/reenviar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="No me llego, enviar de nuevo"
                    android:textColor="@color/verde"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nueva contrasena"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/nueva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autofillHints="newPassword"
                    android:background="@drawable/campo"
                    android:hint="Minimo 6 caracteres"
                    android:inputType="textPassword"
                    android:padding="13dp"
                    android:textColor="@color/negro"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Repite la nueva contrasena"
                    android:textColor="@color/gris"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/repetir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autofillHints="newPassword"
                    android:background="@drawable/campo"
                    android:hint="La misma de arriba"
                    android:inputType="textPassword"
                    android:padding="13dp"
                    android:textColor="@color/negro"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/rojo"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/accion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/verde"
                android:text="Enviar codigo"
                android:textColor="@color/blanco" />

        </LinearLayout>

        <TextView
            android:id="@+id/volver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="Volver al inicio de sesion"
            android:textColor="@color/verde"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
