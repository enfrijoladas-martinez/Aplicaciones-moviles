<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TableLayout: filas y columnas para formularios"
            android:textColor="@color/negro"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cada TableRow es una fila. Las columnas se alinean solas."
            android:textColor="@color/gris"
            android:textSize="12sp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:stretchColumns="1">

            <TableRow>

                <TextView
                    android:layout_gravity="center_vertical"
                    android:padding="8dp"
                    android:text="Nombre"
                    android:textColor="@color/negro" />

                <EditText
                    android:layout_height="wrap_content"
                    android:background="@color/fondo"
                    android:hint="Tu nombre"
                    android:padding="10dp"
                    android:textColor="@color/negro" />

            </TableRow>

            <TableRow>

                <TextView
                    android:layout_gravity="center_vertical"
                    android:padding="8dp"
                    android:text="Matricula"
                    android:textColor="@color/negro" />

                <EditText
                    android:layout_height="wrap_content"
                    android:background="@color/fondo"
                    android:hint="202260437"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="@color/negro" />

            </TableRow>

            <TableRow>

                <TextView
                    android:layout_gravity="center_vertical"
                    android:padding="8dp"
                    android:text="Correo"
                    android:textColor="@color/negro" />

                <EditText
                    android:layout_height="wrap_content"
                    android:background="@color/fondo"
                    android:hint="correo@ucc.mx"
                    android:inputType="textEmailAddress"
                    android:padding="10dp"
                    android:textColor="@color/negro" />

            </TableRow>

            <TableRow>

                <TextView
                    android:layout_gravity="center_vertical"
                    android:padding="8dp"
                    android:text="Semestre"
                    android:textColor="@color/negro" />

                <EditText
                    android:layout_height="wrap_content"
                    android:background="@color/fondo"
                    android:hint="8"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="@color/negro" />

            </TableRow>

        </TableLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Una celda puede ocupar varias columnas"
            android:textColor="@color/negro"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:stretchColumns="*">

            <TableRow>

                <TextView
                    android:background="@color/azul"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="A"
                    android:textColor="@color/blanco" />

                <TextView
                    android:background="@color/verde"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="B"
                    android:textColor="@color/blanco" />

                <TextView
                    android:background="@color/naranja"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="C"
                    android:textColor="@color/blanco" />

            </TableRow>

            <TableRow>

                <TextView
                    android:layout_span="3"
                    android:background="@color/gris"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="Esta celda ocupa las tres columnas"
                    android:textColor="@color/blanco" />

            </TableRow>

        </TableLayout>

    </LinearLayout>

</ScrollView>
