<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="RelativeLayout: cada vista se coloca respecto a otra"
        android:textColor="@color/negro"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/centro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@color/azul"
        android:padding="20dp"
        android:text="CENTRO"
        android:textColor="@color/blanco"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/arriba"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/centro"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp"
        android:background="@color/verde"
        android:padding="12dp"
        android:text="Encima del centro"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/abajo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/centro"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:background="@color/naranja"
        android:padding="12dp"
        android:text="Debajo del centro"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/izquierda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:background="@color/gris"
        android:padding="12dp"
        android:text="Izq."
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/derecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@color/gris"
        android:padding="12dp"
        android:text="Der."
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/esquina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:background="@color/negro"
        android:padding="12dp"
        android:text="Esquina del padre"
        android:textColor="@color/blanco" />

    <TextView
        android:id="@+id/nota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:text="Verde y naranja dependen de CENTRO.\nNegro depende del padre."
        android:textColor="@color/gris"
            android:textSize="12sp" />

    </RelativeLayout>

</FrameLayout>
