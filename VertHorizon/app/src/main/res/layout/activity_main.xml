<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VertHorizon"
            android:textColor="@color/negro"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ciclo de vida y perdida del dato al girar la pantalla"
            android:textColor="@color/gris"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Escribe un valor"
            android:textColor="@color/gris"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/campoValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/blanco"
            android:hint="Escribe algo aqui"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/negro" />

        <Button
            android:id="@+id/botonMostrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/azul"
            android:padding="14dp"
            android:text="Mostrar en el TextView"
            android:textColor="@color/blanco" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Valor mostrado"
            android:textColor="@color/gris"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/blanco"
            android:padding="18dp"
            android:text="Sin valor"
            android:textColor="@color/negro"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/borde_gris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Conservar el dato al girar"
                    android:textColor="@color/negro"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Apagado reproduce el problema. Encendido usa onSaveInstanceState."
                    android:textColor="@color/gris"
                    android:textSize="11sp" />

            </LinearLayout>

            <Switch
                android:id="@+id/interruptorGuardar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Bitacora del ciclo de vida"
            android:textColor="@color/gris"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoBitacora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/negro"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="@color/verde_claro"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Los mismos mensajes salen en Logcat con la etiqueta VertHorizon"
            android:textColor="@color/gris"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
